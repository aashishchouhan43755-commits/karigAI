# GEMINI_API_KEY: Required for Gemini AI API calls (Auto-cataloging, storytelling, vision analysis).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KarigAI Configuration
PORT=3000
NODE_ENV="development"
DEFAULT_LANGUAGE="hi"
AI_PROVIDER_FALLBACK="true"
FAIR_WAGE_HOURLY_BASE_INR="180"

